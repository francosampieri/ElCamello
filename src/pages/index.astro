---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConsultaWhatsApp from '../components/ConsultaWhatsApp.astro';
import { identidad } from '../data/parador.ts';

const { nombre, localidad } = identidad.unidades;
---

<BaseLayout>
  {nombre.estado !== 'pendiente' && <h1>{nombre.valor}</h1>}
  {localidad.estado !== 'pendiente' && <p>{localidad.valor}.</p>}
  <ConsultaWhatsApp ambito={{ tipo: 'general' }} etiqueta="Consultá por tu grupo" />
</BaseLayout>
